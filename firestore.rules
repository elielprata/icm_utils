rules_version = '2';

// Regras da Oração Ininterrupta.
// - Qualquer pessoa com o link vê o período e se inscreve, sem login.
// - Inscrição pública: só como próxima pessoa do horário, nunca substituindo alguém.
// - Quem se inscreveu recebe uma chave secreta (coleção `secrets`, ilegível) e com ela pode trocar ou
//   cancelar a própria inscrição antes do início do período ou nas primeiras 24 h.
// - Só coordenadores (e-mails em `admins`, login Google) editam o período e mexem em qualquer nome.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function validPeriod(p) {
      return p.keys().hasOnly(['motivo', 'motivos', 'start', 'end', 'churches', 'admins', 'createdAt'])
        && p.motivo is string && p.motivo.size() <= 120
        && (!('motivos' in p) || (p.motivos is string && p.motivos.size() <= 2000))
        && p.start is string && p.end is string
        && p.churches is map
        && p.admins is list && p.admins.size() > 0 && p.admins.size() <= 20;
    }

    function validCalendar(c) {
      return c.keys().hasOnly(['name', 'types', 'admins', 'createdAt'])
        && c.name is string && c.name.size() <= 120
        && c.types is map && c.types.size() <= 12
        && c.admins is list && c.admins.size() > 0 && c.admins.size() <= 20;
    }

    match /periods/{periodId} {
      function entryDoc(id) {
        return /databases/$(database)/documents/periods/$(periodId)/entries/$(id);
      }

      function secretDoc(id) {
        return /databases/$(database)/documents/periods/$(periodId)/secrets/$(id);
      }

      function releaseDoc(id) {
        return /databases/$(database)/documents/periods/$(periodId)/releases/$(id);
      }

      function period() {
        return get(/databases/$(database)/documents/periods/$(periodId)).data;
      }

      function isAdmin() {
        return signedIn() && myEmail() in period().admins;
      }

      allow get: if true;
      // A busca "meus períodos" filtra por admins array-contains o próprio e-mail.
      allow list: if signedIn() && myEmail() in resource.data.admins;
      allow create: if signedIn()
        && validPeriod(request.resource.data)
        && myEmail() in request.resource.data.admins;
      allow update: if signedIn()
        && myEmail() in resource.data.admins
        && validPeriod(request.resource.data);
      allow delete: if signedIn() && myEmail() in resource.data.admins;

      match /entries/{entryId} {
        function validEntry(e) {
          return e.keys().hasOnly(['slot', 'level', 'name', 'church', 'createdAt'])
            && e.slot is int && e.slot >= 0 && e.slot < 96
            && e.level is int && e.level >= 0 && e.level < 50
            && entryId == string(e.slot) + '_' + string(e.level)
            && e.name is string && e.name.size() > 0 && e.name.size() <= 40
            && e.church is string && e.church in period().churches;
        }

        // Pública: só a próxima posição do horário (a anterior já existe).
        function nextInSlot(e) {
          return e.level == 0
            || exists(entryDoc(string(e.slot) + '_' + string(e.level - 1)));
        }

        // Antes do início do período (meia-noite UTC do dia de início) ou até 24 h depois da inscrição.
        function inChangeWindow() {
          let s = period().start.split('-');
          return request.time < timestamp.date(int(s[0]), int(s[1]), int(s[2]))
            || request.time < resource.data.createdAt + duration.value(24, 'h');
        }

        // A pessoa provou a chave secreta gravando-a em `releases` no mesmo lote.
        function releasedByOwner() {
          return getAfter(releaseDoc(entryId)).data.key == get(secretDoc(entryId)).data.key;
        }

        allow read: if true;
        // `create` falha se o documento já existe: duas pessoas não pegam a mesma vaga.
        allow create: if validEntry(request.resource.data)
          && request.resource.data.createdAt == request.time
          && (isAdmin() || nextInSlot(request.resource.data));
        // Coordenador corrige nome ou igreja (o horário e a posição não mudam por aqui).
        allow update: if isAdmin()
          && validEntry(request.resource.data)
          && request.resource.data.slot == resource.data.slot
          && request.resource.data.level == resource.data.level
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin() || (inChangeWindow() && releasedByOwner());
      }

      // Chave secreta de cada inscrição. Ninguém lê; só é gravada junto com uma inscrição nova.
      match /secrets/{entryId} {
        function validSecret() {
          let s = request.resource.data;
          return s.keys().hasOnly(['key']) && s.key is string && s.key.size() >= 20 && s.key.size() <= 64;
        }

        allow read: if false;
        allow create, update: if validSecret()
          && !exists(entryDoc(entryId))
          && existsAfter(entryDoc(entryId));
        // Só depois que a inscrição deixa de existir.
        allow delete: if !existsAfter(entryDoc(entryId));
      }

      // Imagem dos motivos (arte recebida da igreja), já reduzida no aparelho. Todos veem; só coordenador muda.
      match /media/{name} {
        allow read: if true;
        allow create, update: if isAdmin()
          && name == 'motivos'
          && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 950000
          && request.resource.data.image.matches('data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+')
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }

      // Prova da chave para liberar a própria inscrição. Ninguém lê.
      match /releases/{entryId} {
        allow read: if false;
        allow create, update: if request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key == get(secretDoc(entryId)).data.key;
      }
    }

    // Calendário de Eventos.
    // - Qualquer pessoa com o link vê o calendário e os eventos (visualização pública, sem edição).
    // - Só secretários (e-mails em `admins`, login Google) criam, editam e apagam eventos e tipos.
    // - Um secretário pode administrar mais de um calendário.
    match /calendars/{calendarId} {
      function calendar() {
        return get(/databases/$(database)/documents/calendars/$(calendarId)).data;
      }

      function isCalendarAdmin() {
        return signedIn() && myEmail() in calendar().admins;
      }

      allow get: if true;
      // A busca "meus calendários" filtra por admins array-contains o próprio e-mail.
      allow list: if signedIn() && myEmail() in resource.data.admins;
      allow create: if signedIn()
        && validCalendar(request.resource.data)
        && myEmail() in request.resource.data.admins;
      allow update: if signedIn()
        && myEmail() in resource.data.admins
        && validCalendar(request.resource.data);
      allow delete: if signedIn() && myEmail() in resource.data.admins;

      match /events/{eventId} {
        function validEvent(e) {
          return e.keys().hasOnly(['date', 'time', 'title', 'note', 'typeId', 'confirmed', 'createdAt'])
            && (!('confirmed' in e) || e.confirmed is bool)
            && e.date is string && e.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && (!('time' in e) || (e.time is string && e.time.matches('[0-9]{2}:[0-9]{2}')))
            && e.title is string && e.title.size() > 0 && e.title.size() <= 80
            && (!('note' in e) || (e.note is string && e.note.size() <= 80))
            && e.typeId is string && e.typeId in calendar().types;
        }

        // Evento marcado como não confirmado (`confirmed: false`): só quem administra o calendário lê.
        allow read: if resource.data.get('confirmed', true) != false || isCalendarAdmin();
        allow create: if isCalendarAdmin() && validEvent(request.resource.data);
        allow update: if isCalendarAdmin() && validEvent(request.resource.data);
        allow delete: if isCalendarAdmin();
      }
    }
  }
}
